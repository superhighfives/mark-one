# Olympus firmware and anything derived from it. scripts/setup.sh fetches
# and unpacks it; the commands in README.md rebuild the rest.
fw/
unpacked/
disasm/
patched/

# Downloaded by scripts/setup.sh (xulfr/om-emu, no license).
tools/

# Built from GNU binutils source.
toolchain/

__pycache__/
.DS_Store
.venv/

# Assembler output; rebuild with the commands in NOTES.md.
asm/**/*.o
asm/**/*.elf
asm/**/*.bin

# Built from mac/; see the build line at the top of each source file.
mac/viewer/viewer
mac/MarkOne/Local.xcconfig
mac/MarkOne/MarkOne.xcodeproj/
mac/MarkOne/build/
/build/
mac/MarkOne/Vendor/

# USB recordings; they contain firmware.
captures/
